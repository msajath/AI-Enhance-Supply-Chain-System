# ==============================================================================
# QORVENZ TECH — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env before starting the development environment:
#   copy .env.example .env
# NEVER COMMIT YOUR LOCAL .env FILE CONTAINING REAL CREDENTIALS TO GIT.
# ==============================================================================

# Server / Backend Configuration
PORT=4000
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173

# Database (PostgreSQL) Configuration
# Default local development port 5434 avoids collisions with any existing host services
DB_HOST=localhost
DB_PORT=5434
DB_USER=qorvenz_user
DB_PASSWORD=qorvenz_dev_secret_2026
DB_NAME=qorvenz_db
DB_SSL=false

# Docker Compose PostgreSQL Settings
POSTGRES_USER=qorvenz_user
POSTGRES_PASSWORD=qorvenz_dev_secret_2026
POSTGRES_DB=qorvenz_db
POSTGRES_PORT=5434

# Authentication & Security (Sprint 1 Foundation)
JWT_SECRET=qorvenz_super_secret_jwt_key_sprint1_minimum_32_characters_long
JWT_EXPIRES_IN=7d

# Frontend Configuration (Vite)
VITE_API_BASE_URL=http://localhost:4000
