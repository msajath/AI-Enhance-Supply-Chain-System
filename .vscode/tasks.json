{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Dev Servers (API + Web)",
      "type": "shell",
      "command": "npm run dev",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Docker: Start PostgreSQL",
      "type": "shell",
      "command": "npm run docker:up",
      "problemMatcher": []
    },
    {
      "label": "Docker: Stop PostgreSQL",
      "type": "shell",
      "command": "npm run docker:down",
      "problemMatcher": []
    },
    {
      "label": "Database: Run Migrations",
      "type": "shell",
      "command": "npm run db:migrate",
      "problemMatcher": []
    },
    {
      "label": "Database: Run Seeds",
      "type": "shell",
      "command": "npm run db:seed",
      "problemMatcher": []
    },
    {
      "label": "Check TypeScript (Typecheck)",
      "type": "shell",
      "command": "npm run typecheck",
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "Run ESLint Linter",
      "type": "shell",
      "command": "npm run lint",
      "problemMatcher": ["$eslint-stylish"]
    },
    {
      "label": "Run All Tests",
      "type": "shell",
      "command": "npm run test",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
